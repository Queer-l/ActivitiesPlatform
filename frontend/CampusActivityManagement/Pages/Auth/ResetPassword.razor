@page "/reset-password"
@inject ApiService ApiService

@* 邮箱重置密码页：通过邮箱验证码直接设置新密码，适用于已绑定邮箱的用户。 *@
<PageTitle>邮箱重置密码</PageTitle>

<div class="card" style="max-width: 400px; margin: 40px auto;">
    <h3>邮箱重置密码</h3>
    <ErrorMessage Message="@_error" OnDismiss="() => _error = string.Empty" />
    <SuccessMessage Message="@_success" OnDismiss="() => _success = string.Empty" />

    <div class="form-group">
        <label>邮箱</label>
        <input class="form-control" @bind="_email" placeholder="请输入绑定的邮箱" />
        <div class="validation-error">@_emailError</div>
    </div>
    <div class="form-group">
        <label>验证码</label>
        <div style="display: flex; gap: 8px;">
            <input class="form-control" @bind="_code" placeholder="4 位验证码" maxlength="4" style="flex:1;" />
            <button class="btn btn-secondary" @onclick="SendCode" disabled="@_isSending">发送验证码</button>
        </div>
        <div class="validation-error">@_codeError</div>
    </div>
    <div class="form-group">
        <label>新密码</label>
        <input class="form-control" type="password" @bind="_newPwd" placeholder="至少 6 位" />
        <div class="validation-error">@_newPwdError</div>
    </div>

    <button class="btn btn-primary" @onclick="HandleReset" disabled="@_isLoading">重置密码</button>
    <div style="margin-top: 16px; font-size: 0.9rem;"><a href="/login">返回登录</a></div>
</div>

@code {
    private string _email = string.Empty;
    private string _code = string.Empty;
    private string _newPwd = string.Empty;
    private string _error = string.Empty;
    private string _success = string.Empty;
    private bool _isLoading;
    private bool _isSending;
    private string _emailError = string.Empty;
    private string _codeError = string.Empty;
    private string _newPwdError = string.Empty;

    private async Task SendCode()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _emailError = "请输入邮箱";
            return;
        }

        _isSending = true;
        _error = string.Empty;

        try
        {
            await ApiService.SendEmailCode(_email);
            _success = "验证码已发送";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSending = false;
        }
    }

    private bool Validate()
    {
        _emailError = string.IsNullOrWhiteSpace(_email) ? "请输入邮箱" : string.Empty;
        _codeError = string.IsNullOrWhiteSpace(_code) ? "请输入验证码" : string.Empty;
        _newPwdError = _newPwd.Length < 6 ? "密码至少 6 位" : string.Empty;
        return string.IsNullOrEmpty(_emailError) && string.IsNullOrEmpty(_codeError) && string.IsNullOrEmpty(_newPwdError);
    }

    private async Task HandleReset()
    {
        if (!Validate())
        {
            return;
        }

        _isLoading = true;
        _error = string.Empty;

        try
        {
            await ApiService.ResetPasswordByEmail(_email, _code, _newPwd);
            _success = "密码重置成功";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
