@page "/my-applies"
@attribute [Authorize]
@inject ApiService ApiService
@inject AuthenticationStateProvider AuthStateProvider
@inject ActivityClientCache ActivityCache

@* 我的活动页：展示当前登录用户发布/申请过的活动。页面合并后端可见活动、审核列表和本地缓存，确保驳回/撤销等状态及时覆盖旧缓存。 *@
<PageTitle>我的活动</PageTitle>

<h2>我的活动</h2>
<ErrorMessage Message="@_error" OnDismiss="() => _error = string.Empty" />
<LoadingOverlay IsLoading="_isLoading" />

@if (_activities != null && _activities.Any())
{
    @* “我的活动”使用表格展示，适合对比同一发布者的多个活动状态、报名人数和时间窗口。 *@
    <div class="table-scroll">
        <table class="table fixed-table my-activities-table">
            <thead>
                <tr>
                    <th>活动名称</th>
                    <th>状态</th>
                    <th>报名人数</th>
                    <th>签到人数</th>
                    <th>活动时间</th>
                    <th>报名时间</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var activity in _activities)
            {
                @* 每一行对应当前登录用户发布/申请过的一条活动记录；状态可能来自审核接口、可见活动列表或本地缓存的合并结果。 *@
                <tr>
                    <td title="@activity.Title">@activity.Title</td>
                    <td><span class="badge @GetStatusBadgeClass(activity)">@GetStatusText(activity)</span></td>
                    <td>@activity.CurrentCount / @activity.MaxCount</td>
                    <td>@activity.SignInCount</td>
                    <td>@activity.ActivityStartTime ~ @activity.ActivityEndTime</td>
                    <td>@activity.EnrollStartTime ~ @activity.EnrollEndTime</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else if (!_isLoading)
{
    <p>暂无活动记录</p>
}

@code {
    private List<ActivityDto>? _activities;
    private string _currentUserName = string.Empty;
    private string _error = string.Empty;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUser();
        await LoadActivities();
    }

    private async Task LoadCurrentUser()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserName = state.User.Identity?.Name ?? string.Empty;
    }

    // “我的活动”不能只依赖普通活动列表：待审核和已驳回记录可能只存在于审核接口或本地缓存中。
    private async Task LoadActivities()
    {
        _isLoading = true;
        _error = string.Empty;

        try
        {
            // GetActivitysList 返回仍对普通用户可见的活动。
            // GetActivityApplies 能补充待审核/已驳回等审核状态。
            // Local cache 保存刚提交、刚撤销等后端列表暂时拿不到的记录。
            var serverActivities = await ApiService.GetActivitysList();
            var auditActivities = await TryGetActivityAppliesAsync();
            var cachedActivities = await ActivityCache.GetActivitiesAsync();

            // 三类数据合并后再按发布人过滤，只展示当前登录用户自己的活动。
            // 排序优先使用创建时间，没有创建时间时退回活动开始时间。
            _activities = MergeActivities(serverActivities, auditActivities, cachedActivities)
                .Where(activity => string.Equals(activity.PublisherUserName, _currentUserName, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(activity => ParseDate(activity.CreateTime) ?? ParseDate(activity.ActivityStartTime) ?? DateTime.MinValue)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    // 普通用户没有审核权限时该调用可能失败；失败时保留已有 server/cache 数据继续展示页面。
    private async Task<List<ActivityDto>?> TryGetActivityAppliesAsync()
    {
        try
        {
            return await ApiService.GetActivityApplies();
        }
        catch
        {
            return null;
        }
    }

    // 合并顺序体现优先级：本地缓存最低，可见活动列表居中，审核列表最新且可覆盖旧草稿状态。
    private static List<ActivityDto> MergeActivities(
        List<ActivityDto>? serverActivities,
        List<ActivityDto>? auditActivities,
        List<ActivityDto>? cachedActivities)
    {
        var merged = new Dictionary<string, ActivityDto>();

        // 本地缓存优先放入字典，作为最基础的数据来源。
        // 后续如果后端返回了同一活动，会覆盖这些本地草稿/旧状态。
        foreach (var activity in cachedActivities ?? new List<ActivityDto>())
        {
            merged[GetActivityKey(activity)] = activity;
        }

        // 可见活动列表代表活动已通过审核且仍在架上。
        // 若找到同标题、同发布者、同开始时间的本地草稿，就移除草稿，避免列表出现重复行。
        foreach (var activity in serverActivities ?? new List<ActivityDto>())
        {
            var draftKey = $"draft:{activity.PublisherUserName}:{activity.Title}:{activity.ActivityStartTime}";
            merged.Remove(draftKey);
            merged[GetActivityKey(activity)] = activity;
        }

        // 审核列表通常包含最新审核状态，优先级最高，可覆盖本地缓存和普通列表中的旧状态。
        foreach (var activity in auditActivities ?? new List<ActivityDto>())
        {
            var draftKey = $"draft:{activity.PublisherUserName}:{activity.Title}:{activity.ActivityStartTime}";
            merged.Remove(draftKey);
            merged[GetActivityKey(activity)] = activity;
        }

        return merged.Values.ToList();
    }

    private static string GetActivityKey(ActivityDto activity)
    {
        return activity.Id > 0
            ? $"id:{activity.Id}"
            : $"draft:{activity.PublisherUserName}:{activity.Title}:{activity.ActivityStartTime}";
    }

    private static DateTime? ParseDate(string? value)
    {
        return DateTime.TryParse(value, out var parsed) ? parsed : null;
    }

    private static string GetStatusText(ActivityDto activity)
    {
        return activity.DisplayStatusText;
    }

    private static string GetStatusBadgeClass(ActivityDto activity)
    {
        return GetStatusText(activity) switch
        {
            "报名中" => "badge-success",
            "进行中" => "badge-success",
            "待审核" => "badge-warning",
            "待开始" => "badge-warning",
            "预热中" => "badge-info",
            "已撤销" => "badge-danger",
            "已下架" => "badge-danger",
            "已结束" => "badge-danger",
            "已驳回" => "badge-danger",
            _ => "badge-info"
        };
    }

}
