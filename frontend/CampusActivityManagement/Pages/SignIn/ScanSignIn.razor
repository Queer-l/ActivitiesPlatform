@page "/scan-signin"
@attribute [Authorize]
@inject ApiService ApiService

@* 扫码签到页：参与者输入签到码完成签到，最终权限和活动时间校验由后端决定。 *@
<PageTitle>扫码签到</PageTitle>

<div class="card" style="max-width:500px;margin:20px auto;">
    <h3>扫码签到</h3>
    <ErrorMessage Message="@_error" OnDismiss="() => _error = string.Empty" />
    <SuccessMessage Message="@_success" OnDismiss="() => _success = string.Empty" />
    <LoadingOverlay IsLoading="_isLoading" />

    <div class="form-group">
        <label>签到码</label>
        <input class="form-control" @bind="_code" placeholder="请输入活动签到码" maxlength="12" />
        <div class="validation-error">@_codeError</div>
    </div>

    <button class="btn btn-primary" @onclick="HandleSignIn" disabled="@_isLoading">确认签到</button>
</div>

@code {
    private string _code = string.Empty;
    private string _codeError = string.Empty;
    private string _error = string.Empty;
    private string _success = string.Empty;
    private bool _isLoading;
    private async Task HandleSignIn()
    {
        _codeError = string.IsNullOrWhiteSpace(_code) ? "请输入签到码" : string.Empty;
        if (!string.IsNullOrEmpty(_codeError))
        {
            return;
        }

        _isLoading = true;
        _error = string.Empty;
        _success = string.Empty;

        try
        {
            // 签到码由活动发布者生成，后端根据签到码识别活动并记录当前登录用户。
            await ApiService.ScanSignIn(_code.Trim());
            _code = string.Empty;
            _success = "签到成功";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
