@page "/generate-code"
@attribute [Authorize]
@inject ApiService ApiService

@* 生成签到码页：活动发布者输入活动 ID，向后端申请短期有效的签到码。 *@
<PageTitle>生成签到码</PageTitle>

<div class="card" style="max-width:500px;margin:20px auto;">
    <h3>📋 生成签到码</h3>
    <ErrorMessage Message="@_error" OnDismiss="() => _error = null" />
    <SuccessMessage Message="@_success" OnDismiss="() => _success = null" />
    <LoadingOverlay IsLoading="_isLoading" />

    <div class="form-group">
        <label>活动 ID</label>
        <input class="form-control" type="number" @bind="_activityId" min="1" />
        <div class="validation-error">@_activityIdError</div>
    </div>
    <button class="btn btn-primary" @onclick="Generate" disabled="@_isLoading">生成签到码</button>

    @if (!string.IsNullOrEmpty(_code))
    {
        <div class="alert alert-success mt-16">
            <h4>签到码: <strong style="font-size:1.5rem;letter-spacing:2px;">@_code</strong></h4>
            <p>有效期10分钟，请尽快使用</p>
        </div>
    }
</div>

@code {
    private int _activityId;
    private string _code = "";
    private string _error = ""; private string _success = ""; private bool _isLoading;
    private string _activityIdError = "";

    private async Task Generate()
    {
        if (_activityId < 1) { _activityIdError = "请输入有效的活动ID"; return; }
        _isLoading = true; _error = ""; _code = "";
        try { _code = await ApiService.GenerateSignInCode(_activityId) ?? ""; _success = "生成成功"; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isLoading = false; }
    }
}
